        941,
        952
      ],
      "start": 550.16,
      "end": 553.12
    },
    {
      "en": "It was two years ago, in August, in California.",
      "asr_range": [
        952,
        961
      ],
      "start": 553.86,
      "end": 558.02
    },
    {
      "en": "What are your plans for the next holiday?",
