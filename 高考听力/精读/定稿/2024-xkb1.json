      ],
      "start": 985.05,
      "end": 989.29
    },
    {
      "en": "Have a plan of what you want your kitchen garden to look like.",
      "asr_range": [
        1640,
        1653
      ],
      "start": 990.01,
      "end": 993.69
    },
    {
