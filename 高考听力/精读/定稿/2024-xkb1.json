    {
      "en": "Welcome to Meet the Author.",
      "asr_range": [
        1912,
        1917
      ],
      "start": 1137.19,
      "end": 1139.43
    },
    {
      "en": "Well, many readers of Sports Times turn to the last page of their magazine first in order to read Jacob Johnson's weekly article under the title Life of Johnson.",
      "asr_range": [
        1917,
        1946
      ],
      "start": 1140.07,
      "end": 1151.11
    },
    {
      "en": "The articles, along with his novels and essay collections, have earned Johnson the reputation as one of the funniest humans on the planet.",
      "asr_range": [
        1946,
        1969
      ],
      "start": 1151.55,
      "end": 1160.67
    },
    {
      "en": "Johnson began writing about sports as a second-year student at the University of Colorado, covering high school volleyball games for his hometown newspaper.",
      "asr_range": [
        1969,
        1993
      ],
      "start": 1161.07,
      "end": 1171.23
    },
    {
      "en": "After graduating in nineteen eighty-one he moved on to work at the Denver Weekly for two years and the Los Angeles Post for two more years before landing at Sports Times.",
      "asr_range": [
        1993,
        2025
      ],
      "start": 1171.84,
      "end": 1183.92
    },
    {
      "en": "He has been voted National Sports Writer of the Year eleven times.",
      "asr_range": [
        2025,
        2037
      ],
      "start": 1184.52,
      "end": 1189.16
    },
