    {
      "en": "Questions fourteen through sixteen are based on the following talk.",
      "asr_range": [
        966,
        976
      ],
      "start": 511.07,
      "end": 515.47
    },
    {
      "en": "Wearable devices are not just for humans anymore.",
      "asr_range": [
        976,
        985
      ],
      "start": 516.24,
      "end": 520.0
    },
    {
      "en": "A growing range of electronic collars and cameras can help you monitor your pet's activity and even emotional state.",
      "asr_range": [
        985,
        1004
      ],
      "start": 520.24,
      "end": 528.32
    },
    {
      "en": "Was your cat happy?",
      "asr_range": [
        1004,
        1008
      ],
      "start": 528.81,
      "end": 530.57
    },
    {
      "en": "How much exactly did your dog eat today?",
      "asr_range": [
        1008,
        1016
      ],
      "start": 530.81,
      "end": 533.45
    },
    {
      "en": "Knowing the answers to such questions is becoming ever easier.",
      "asr_range": [
        1016,
        1026
      ],
      "start": 533.69,
      "end": 538.17
    },
    {
      "en": "This week, the insurance group ASA invested in a company called All4Pet, which makes the PetMe, a wearable activity monitor for dogs.",
