      ],
      "start": 1122.65,
      "end": 1126.89
    },
    {
      "en": "Good evening, dear listeners.",
      "asr_range": [
        1850,
        1854
      ],
      "start": 1182.51,
      "end": 1184.43
    },
    {
      "en": "When was the last time you enjoyed leisure activities?",
      "asr_range": [
        1854,
        1863
      ],
      "start": 1185.05,
      "end": 1188.97
    },
    {
      "en": "Do you want to live a full and happy life?",
      "asr_range": [
        1863,
        1873
      ],
      "start": 1189.21,
      "end": 1192.65
    },
    {
      "en": "Today I am going to introduce to you a magazine that features the art of living.",
      "asr_range": [
        1873,
        1889
      ],
      "start": 1193.21,
      "end": 1199.21
    },
    {
      "en": "The Idler was launched by Tom Hodgkinson back in nineteen ninety-three, with the intention of providing a bit of fun, freedom, and achievement in a busy world.",
      "asr_range": [
        1889,
        1917
      ],
      "start": 1199.94,
      "end": 1213.06
    },
    {
      "en": "It is now published bimonthly.",
      "asr_range": [
        1917,
        1923
      ],
      "start": 1213.85,
      "end": 1216.81
    },
    {
      "en": "In every issue you'll find an interesting mix of interviews and essays on the good life, history, philosophy, arts, and fashion photography.",
      "asr_range": [
        1923,
        1945
      ],
      "start": 1217.05,
      "end": 1229.29
    },
    {
      "en": "You'll find much to laugh at and much useful stuff as well, from recipes for making bacon to guides to housekeeping.",
      "asr_range": [
        1945,
        1966
      ],
      "start": 1229.88,
      "end": 1239.64
    },
    {
      "en": "If you've ever felt that there's more to life than boring jobs, then why not subscribe to it?",
      "asr_range": [
        1966,
        1984
      ],
      "start": 1239.88,
      "end": 1247.48
    },
    {
      "en": "The Idler is a cheering read that makes you feel better about life.",
      "asr_range": [
        1984,
        1997
      ],
      "start": 1247.72,
      "end": 1253.24
    },
