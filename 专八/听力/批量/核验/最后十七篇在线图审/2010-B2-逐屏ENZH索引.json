    "file": "screen028.png",
    "sha256": "80ba2da8cd5941ec8aa861475315197586ec41e521efb391bfc094c47d9b1b8d",
    "k": 25,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "Yes, that is true.",
    "zh": "是的，确实如此。",
    "vocabulary": [
      "true"
    ]
  },
  {
    "file": "screen029.png",
    "sha256": "9ec592e051e1f142ef909fd017ed11b2b3ac14664c6e2b84090014444e52ec3e",
    "k": 26,
    "part": 1,
    "parts": 1,
    "role": null,
