    ]
  },
  {
    "file": "screen006.png",
    "sha256": "9ced4b10cfd89ead8f3d1b05262016193170c68697136388711f2cea9d828b74",
    "k": 5,
    "part": 1,
    "parts": 1,
    "role": "instruction",
    "en": "In this section you will hear a mini-lecture.",
    "zh": "在这一节中，你将听到一段短讲。",
    "vocabulary": [
      "hear"
    ]
  },
  {
    "file": "screen007.png",
    "sha256": "a5e19125491abb80e878d126230fe8189999ced7bc7485c517aa445e91f800ff",
    "k": 6,
    "part": 1,
    "parts": 1,
    "role": "instruction",
    "en": "You will hear the mini-lecture once only.",
    "zh": "这段短讲只播放一遍。",
    "vocabulary": [
      "once"
    ]
  },
  {
    "file": "screen008.png",
    "sha256": "535578e989ac38de975b079bc2ea9cc32ad8678106c57ce5e3e6e2c9dc6f7539",
    "k": 7,
    "part": 1,
    "parts": 1,
    "role": "instruction",
    "en": "While listening to the mini-lecture, please complete the gap-filling task on Answer Sheet 1 and write no more than three words for each gap.",
    "zh": "请边听短讲，边完成答题卡一上的填空任务；每空填写不超过三个词。",
    "vocabulary": [
      "gap-filling"
    ]
  },
  {
    "file": "screen009.png",
    "sha256": "430effe52be6cd11af32f3c7d9e5bb3ecd15b824b0fbd9cb3a964e47b568a206",
    "k": 8,
    "part": 1,
    "parts": 1,
    "role": "instruction",
    "en": "Make sure the word(s) you fill in is or are both grammatically and semantically acceptable.",
    "zh": "请确保填入的词在语法和语义上都恰当。",
    "vocabulary": [
      "acceptable"
    ]
  },
  {
    "file": "screen010.png",
    "sha256": "2226e375bf5ad1d8a32a5e1dd12e36676fe0299e71e52348cb590b68bd2a425f",
    "k": 9,
    "part": 1,
    "parts": 1,
    "role": "instruction",
    "en": "You may use the blank sheet for note-taking.",
    "zh": "你可以用空白纸做笔记。",
    "vocabulary": [
      "blank"
    ]
  },
  {
    "file": "screen011.png",
    "sha256": "d7543ac41ab4d3fbe58a7bdca7a5e216e85be772751cfc8a63349fa1d347977d",
    "k": 10,
    "part": 1,
    "parts": 1,
    "role": "instruction",
    "en": "You have thirty seconds to preview the gap-filling task.",
    "zh": "你有三十秒钟预览填空任务。",
    "vocabulary": [
      "preview"
    ]
  },
  {
    "file": "screen012.png",
    "sha256": "20a94e0533e86219be2f5113a703339c335cfdb95806c85a4064a1e905a45ea8",
    "k": 11,
    "part": 1,
    "parts": 1,
    "role": "transition",
    "en": "Now, listen to the mini-lecture.",
    "zh": "现在请听短讲。",
    "vocabulary": [
      "listen"
    ]
  },
  {
    "file": "screen013.png",
    "sha256": "61231da983a28105207c64c2dc761c985547b44f662f34b13181ed4742205c58",
    "k": 12,
    "part": 1,
    "parts": 1,
    "role": "transition",
    "en": "When it is over, you will be given three minutes to check your work.",
    "zh": "短讲结束后，你将有三分钟检查作答。",
    "vocabulary": [
      "check"
    ]
  },
  {
    "file": "screen014.png",
    "sha256": "7c9e83cb14a5ef5f68b74059d4af5c467b50423c7a043ab7c63d74e987437af4",
    "k": 13,
    "part": 1,
    "parts": 1,
    "role": "transition",
    "en": "Understanding academic lectures.",
    "zh": "理解学术讲座。",
    "vocabulary": [
      "academic"
    ]
  },
  {
    "file": "screen015.png",
    "sha256": "6ed88491d2c03266624e14f7f3b92c5ee19bb709bbecbbda38e26f0bb22518dd",
    "k": 14,
    "part": 1,
    "parts": 1,
    "role": "body",
    "en": "Good morning, everybody.",
    "zh": "大家早上好。",
    "vocabulary": [
      "Good morning"
    ]
  },
  {
    "file": "screen016.png",
    "sha256": "3e1a67982dfe198bd56d05b99ec4cb5f1e58b195a9408de7b75bf9228667f23f",
    "k": 15,
    "part": 1,
    "parts": 2,
    "role": "body",
    "en": "Now, at the university, you, as students, are often called on to perform many types of listening tasks: ",
    "zh": "在大学里，作为学生，你们经常需要完成各种听力任务：",
    "vocabulary": [
      "perform"
    ]
  },
  {
    "file": "screen017.png",
    "sha256": "e6e1743f9af5bd68809a6d70c1ab954993600b837c0c4db04d6fa1a71e49ece0",
    "k": 15,
    "part": 2,
    "parts": 2,
    "role": "body",
    "en": "listening in a group discussion, listening to a teacher on a one-to-one basis, and listening to academic lectures.",
    "zh": "听小组讨论、与老师一对一交谈，以及听学术讲座。",
    "vocabulary": [
      "on a one-to-one basis"
    ]
  },
  {
    "file": "screen018.png",
    "sha256": "1f4bd9858aeb3643a41d155c42a75bb362c80538d274971faafde047f508a26f",
    "k": 16,
    "part": 1,
    "parts": 1,
    "role": "body",
    "en": "So what I’m going to talk about today is what a listener needs to be able to do in order to comprehend an academic lecture efficiently.",
    "zh": "因此，今天我要讲的是，听众要具备哪些能力，才能高效地理解一场学术讲座。",
    "vocabulary": [
      "comprehend"
    ]
  },
  {
    "file": "screen019.png",
    "sha256": "dd385f585ab749430167ea59b1ac9d673fbcb3db61ea59eb82f03132e94e2871",
    "k": 17,
    "part": 1,
    "parts": 1,
    "role": "body",
    "en": "OK.",
    "zh": "好。",
    "vocabulary": [
      "OK"
    ]
  },
  {
    "file": "screen020.png",
    "sha256": "5a67e5923d31ed0eba7fe251ad31c3c57ddfe6d2c85d265774d1592a1e1f3948",
    "k": 18,
    "part": 1,
    "parts": 1,
    "role": "body",
    "en": "What do you need to do in order to understand the lecture?",
    "zh": "要听懂讲座，你需要做些什么呢？",
    "vocabulary": [
      "lecture"
    ]
  },
  {
    "file": "screen021.png",
    "sha256": "62a46116462120c5058998c0bf64dfeadad529cbc9f3103cb24fe89e8316dcd9",
    "k": 19,
    "part": 1,
    "parts": 1,
    "role": "body",
    "en": "Now there are four things that I’m going to talk about.",
    "zh": "接下来，我要谈四个方面。",
    "vocabulary": [
      "talk about"
    ]
  },
  {
    "file": "screen022.png",
    "sha256": "46d97f1faa1b70c60787bd3ab66bf87f4f36df7ea554d35b86e4214eb386f7bd",
    "k": 20,
    "part": 1,
    "parts": 1,
    "role": "body",
    "en": "The first thing is that you need to be aware of all of the parts of the language that carry meaning.",
    "zh": "首先，你需要意识到，语言中所有能够传达意义的组成部分都值得注意。",
    "vocabulary": [
      "be aware of"
    ]
  },
  {
    "file": "screen023.png",
    "sha256": "e7da7e2e29e95d25d0466166432f9df11cbc1bd39f1b4a6cfb9c1900113bb9a3",
    "k": 21,
    "part": 1,
    "parts": 1,
    "role": "body",
    "en": "You all know that words carry meaning.",
    "zh": "你们都知道，词语能够传达意义。",
    "vocabulary": [
      "carry meaning"
    ]
  },
  {
    "file": "screen024.png",
    "sha256": "b7c7fec1496fbd2bdc04d45f8e37c5ba7052a7047a385dd37bbd8618854bae29",
    "k": 22,
    "part": 1,
    "parts": 1,
    "role": "body",
    "en": "So you've got to be aware of the vocabulary of the language, but there are some other features.",
    "zh": "所以，你必须了解这门语言的词汇，但除此之外，还有其他特征。",
    "vocabulary": [
      "vocabulary"
    ]
  },
  {
    "file": "screen025.png",
    "sha256": "ccb73ff46d53f9f4a5951f91679e109f083e35c22f252b230e6d2b1511d49349",
    "k": 23,
    "part": 1,
    "parts": 1,
    "role": "body",
    "en": "For one thing, you need to be aware of stress.",
    "zh": "例如，你需要注意重音。",
    "vocabulary": [
      "stress"
    ]
  },
  {
    "file": "screen026.png",
    "sha256": "1de56b88a07324ceb21a74fc3386985bdac9567ae2b540b8943d3e2195ebf11a",
    "k": 24,
    "part": 1,
    "parts": 1,
    "role": "body",
    "en": "Let me give you an example.",
    "zh": "我来举个例子。",
    "vocabulary": [
      "example"
    ]
  },
  {
    "file": "screen027.png",
    "sha256": "21cbca3a7d1971e1b5b9252bae93ae159c6f6cd7867d27a0f1e1c640613be24f",
    "k": 25,
    "part": 1,
    "parts": 1,
    "role": "body",
    "en": "“I went to the bar.” “I went to the bar.” It makes a difference.",
    "zh": "“我去了酒吧。”“是我去了酒吧。”这样读，意思就有所不同。",
    "vocabulary": [
      "make a difference"
    ]
  },
  {
    "file": "screen028.png",
    "sha256": "667bb5f4dcd557660bef9a92f261dd60f013506e0c7707bab3c1c8546ad69151",
    "k": 26,
    "part": 1,
    "parts": 1,
    "role": "body",
    "en": "In the second example, I’m stressing the fact that it was me and not someone else so that this means stress has some meaning.",
    "zh": "在第二个例子里，我强调的是去酒吧的人是我，而不是别人；这就说明，重音本身也传递意义。",
    "vocabulary": [
      "stress"
    ]
  },
  {
    "file": "screen029.png",
    "sha256": "536eb854cdc2de80e69218e3b85f12a49f2f248a4d505cfdeb530bfa9d70158c",
    "k": 27,
    "part": 1,
    "parts": 1,
    "role": "body",
    "en": "Now the next thing you might want to listen for is intonation.",
    "zh": "接下来，你可能需要留意的是语调。",
    "vocabulary": [
      "intonation"
    ]
  },
  {
    "file": "screen030.png",
    "sha256": "011e159c46fd518075d0b39bde3872e985dd7c52c7c0842fe7bbfea4c3bdf4dc",
    "k": 28,
    "part": 1,
    "parts": 1,
    "role": "body",
    "en": "For example, if I say “He came.” “He came?” There are two different meanings.",
    "zh": "比如，我说“他来了。”“他来了？”这两句话表达的是不同的意思。",
    "vocabulary": [
      "different meanings"
    ]
  },
  {
    "file": "screen031.png",
    "sha256": "6471f8ab8729eda30650cd9edd7e549f674581de3659406b0d5aa8748f6ff89c",
    "k": 29,
    "part": 1,
    "parts": 1,
    "role": "body",
    "en": "One is a statement, the other one is a question.",
    "zh": "一个是陈述，另一个是提问。",
    "vocabulary": [
      "statement"
    ]
  },
  {
    "file": "screen032.png",
    "sha256": "10c4bacd0b3468fa1d24805d77790ef8a14507d18025c81aece7836a236a5301",
    "k": 30,
    "part": 1,
    "parts": 1,
    "role": "body",
    "en": "And another thing you need to listen for is rhythm.",
    "zh": "你还需要留意节奏。",
    "vocabulary": [
      "rhythm"
    ]
  },
  {
    "file": "screen033.png",
    "sha256": "da098d40f211b6584a33079249d43fbee99a974d9ea2a44617acc74358f693e0",
    "k": 31,
    "part": 1,
    "parts": 1,
    "role": "body",
    "en": "For instance, “Can you see, Mary?” versus “Can you see Mary?” da da DA da... da da da DA da.",
    "zh": "比如，“玛丽，你看得见吗？”与“你看得见玛丽吗？”——哒哒哒哒……哒哒哒哒。",
    "vocabulary": [
      "For instance"
    ]
  },
  {
    "file": "screen034.png",
    "sha256": "ad492d7c20116863f84d27883c453e02e4d96312ac709fffd4ce25d9765e4179",
    "k": 32,
    "part": 1,
    "parts": 1,
    "role": "body",
    "en": "Those two mean something different.",
    "zh": "这两种说法表达的意思不同。",
    "vocabulary": [
      "mean"
    ]
  },
  {
    "file": "screen035.png",
    "sha256": "34d120df4672a693f5b3e38d357ce40f70fb8b05393181ca6c8d526432d571ee",
    "k": 33,
    "part": 1,
    "parts": 1,
    "role": "body",
    "en": "In the first one, they are talking directly to Mary, while the second one means “Can you see Mary... over there?”",
    "zh": "第一种说法是直接对玛丽说话，而第二种则是问：“你看得见那边的玛丽吗？”",
    "vocabulary": [
      "directly"
    ]
  },
  {
    "file": "screen036.png",
    "sha256": "e5866889892dfdd4cc5c255327ece8c4467859ff84a1eae3d72a73dd8f2b99d2",
    "k": 34,
    "part": 1,
    "parts": 1,
    "role": "body",
    "en": "Now the next thing you must do when you listen is that you need to add information that the lecturer expects you to add.",
    "zh": "接下来，听的时候你还必须补充一些信息，而讲课人会预期你能够自行补上这些信息。",
    "vocabulary": [
      "lecturer"
    ]
  },
  {
    "file": "screen037.png",
    "sha256": "697534273c5ad364cb1865dbdbbdbc4c3151cd3b323ef6d310ecf6af6a741da7",
    "k": 35,
    "part": 1,
    "parts": 1,
    "role": "body",
    "en": "All lecturers assume that they share some information with their audience and that their audience does not need them to explain every word.",
    "zh": "所有讲课人都会假定，自己与听众掌握着某些共同信息，因此不必逐字解释每个词。",
    "vocabulary": [
      "assume"
    ]
  },
  {
    "file": "screen038.png",
    "sha256": "7e9c80b53a154003cbf1faddac4bce9b3e7ba5bf0be44d040416c1f40bcb43ed",
    "k": 36,
    "part": 1,
    "parts": 1,
    "role": "body",
    "en": "And listeners have an ability to add this information due to two sources of information.",
    "zh": "听众能够补充这些信息，是因为他们有两种信息来源。",
    "vocabulary": [
      "source"
    ]
  },
  {
    "file": "screen039.png",
    "sha256": "184077a391577f651b578fa03480b9e576630df45aa1a9e00c11acfa83078293",
    "k": 37,
    "part": 1,
    "parts": 1,
    "role": "body",
    "en": "That is, one, their knowledge of a particular subject; and, two, their knowledge or experience of the world.",
    "zh": "第一，是对某个特定学科的了解；第二，是对世界的知识或生活经验。",
    "vocabulary": [
      "a particular subject"
    ]
  },
  {
    "file": "screen040.png",
    "sha256": "3d4871e8ca71f197e776abb2673f34e11c200f94fe49f4470a8b8d60fbbf6ece",
    "k": 38,
    "part": 1,
    "parts": 1,
    "role": "body",
    "en": "So remember: listening is not a matter of just absorbing the speaker’s words; the listener has to do more than that.",
    "zh": "所以，请记住：听讲并不是仅仅接收说话人的话语，听众还需要做得更多。",
    "vocabulary": [
      "absorb"
    ]
  },
  {
    "file": "screen041.png",
    "sha256": "b422a09145ad8f6a39b15f7d01e6afc522a8c50e1b7ff96ae6559a212efac963",
    "k": 39,
    "part": 1,
    "parts": 1,
    "role": "body",
    "en": "The listener is not a tape recorder, absorbing the speaker’s words and putting them into his or her brain.",
    "zh": "听众不是录音机，不会只是接收说话人的话，再把这些话存进脑海。",
    "vocabulary": [
      "tape recorder"
    ]
  },
  {
    "file": "screen042.png",
    "sha256": "4c10f520da031f6020b5e17ab95e319af6adff6b708d51f1a4ccd024f7d01d70",
    "k": 40,
    "part": 1,
    "parts": 1,
    "role": "body",
    "en": "Rather, listening involves hearing the speaker's words and reinterpreting them, adding information if necessary.",
    "zh": "相反，听的过程包括听见说话人的话、重新理解这些话，并在必要时补充信息。",
    "vocabulary": [
      "reinterpret"
    ]
  },
  {
    "file": "screen043.png",
    "sha256": "15efd98ff572bc9c6f14a4c3b51e7d31b4162c66bff11320624ee4d282708e7e",
    "k": 41,
    "part": 1,
    "parts": 2,
    "role": "body",
    "en": "So the meaning is not in the word alone, rather it is in the person who uses it or responds to it so that the second thing that a listener must do— ",
    "zh": "因此，意义并不只存在于词语本身，也存在于使用这些词语、或对其作出回应的人身上。所以，听众要做的第二件事，",
    "vocabulary": [
      "respond to"
    ]
  },
  {
    "file": "screen044.png",
    "sha256": "59f13005dc822de6ef3009f68cd470666541d07abf8ce871a51969d4f2fb0bc1",
    "k": 41,
    "part": 2,
    "parts": 2,
    "role": "body",
    "en": "add information that the lecturer assumes that they share.",
    "zh": "就是补充讲课人假定双方都知道的信息。",
    "vocabulary": [
      "assume"
    ]
  },
  {
    "file": "screen045.png",
    "sha256": "1ee39395e7bc1d42e69e34c7735d460022dce381d11eb7ba15ccbb01544c8759",
    "k": 42,
    "part": 1,
    "parts": 1,
    "role": "body",
    "en": "OK.",
    "zh": "好。",
    "vocabulary": [
      "OK"
    ]
  },
  {
    "file": "screen046.png",
    "sha256": "c60b4308e6c70adae6bb5e3a3cfc7d575e9e24e4dca7134e2e390775d7019ed3",
    "k": 43,
    "part": 1,
    "parts": 1,
    "role": "body",
    "en": "The third thing that a listener needs to do, and this is to me the most important thing of all, and that’s to predict as you listen.",
    "zh": "听众需要做的第三件事——在我看来也是最重要的一件事——就是边听边预测。",
    "vocabulary": [
      "predict"
    ]
  },
  {
    "file": "screen047.png",
    "sha256": "dfea4de937ca5d7c2baf136369190b5b29564620b09a376299273e9894738297",
    "k": 44,
    "part": 1,
    "parts": 1,
    "role": "body",
    "en": "Now let me give you two reasons why you have to predict.",
    "zh": "现在，我来解释为什么要预测，原因有两个。",
    "vocabulary": [
      "reason"
    ]
  },
  {
    "file": "screen048.png",
    "sha256": "bb16363d9bd159d3f315c52afd3eb5de27a106d9489d78badaa767a0e07553c4",
    "k": 45,
    "part": 1,
    "parts": 1,
    "role": "body",
    "en": "For one thing, if you predict it helps you overcome noise.",
    "zh": "首先，预测有助于你克服噪声的干扰。",
    "vocabulary": [
      "overcome"
    ]
  },
  {
    "file": "screen049.png",
    "sha256": "f8b2ccb6e0fae3ce11202b7ab7e2daa07d199474881160b8084988ca444a169b",
    "k": 46,
    "part": 1,
    "parts": 1,
    "role": "body",
    "en": "What do I mean by noise?",
    "zh": "这里所说的“噪声”是什么意思呢？",
    "vocabulary": [
      "noise"
    ]
  },
  {
    "file": "screen050.png",
    "sha256": "0083076ebee7944d4a3ea49947bc4356c0da9c4cdcbe20ded09569840bd543e9",
    "k": 47,
    "part": 1,
    "parts": 1,
    "role": "body",
    "en": "Maybe there’s noise outside and you can’t hear me.",
    "zh": "也许外面很吵，以至于你听不见我说话。",
    "vocabulary": [
      "outside"
    ]
  },
  {
    "file": "screen051.png",
    "sha256": "866fcb47cb9b62472599f5408c3cb391bd6853543abe354b4b533b877bbdb47d",
    "k": 48,
    "part": 1,
    "parts": 1,
    "role": "body",
    "en": "Maybe you're in the back of the room and you can’t hear all that well.",
    "zh": "也许你坐在教室后面，听得不太清楚。",
    "vocabulary": [
      "in the back of"
    ]
  },
  {
    "file": "screen052.png",
    "sha256": "298c49d5e185bda1794506fb02f2107faa6d11665b5fffea0e168c1b09ae319d",
    "k": 49,
    "part": 1,
    "parts": 1,
    "role": "body",
    "en": "Maybe the microphone doesn’t work.",
    "zh": "也许麦克风出了故障。",
    "vocabulary": [
      "microphone"
    ]
  },
  {
    "file": "screen053.png",
    "sha256": "35b697ff16b06d25bd534b79199c586a92dabcf7d607ee1460e52c7b3daae7b8",
    "k": 50,
    "part": 1,
    "parts": 1,
    "role": "body",
    "en": "Maybe there’s noise inside your head.",
    "zh": "也许噪声来自你的脑海。",
    "vocabulary": [
      "inside your head"
    ]
  },
  {
    "file": "screen054.png",
    "sha256": "c441d789c0f8e9018c9ac44090ddcb9d15524e3d3b2210c993db214a914387c2",
    "k": 51,
    "part": 1,
    "parts": 1,
    "role": "body",
    "en": "By that I mean maybe you're thinking of something else.",
    "zh": "我的意思是，你可能正在想着其他事情。",
    "vocabulary": [
      "something else"
    ]
  },
  {
    "file": "screen055.png",
    "sha256": "9006447fad2f204bd2a4e33ebfb459cd2639d07bc65c904d37dcc2ed86472e2c",
    "k": 52,
    "part": 1,
    "parts": 2,
    "role": "body",
    "en": "And then all of a sudden, you'll remember “Oh, I’ve got to listen.” By being able to predict during the lecture, ",
    "zh": "随后，你会突然想起来：“哦，我得认真听。”如果你能在听讲时进行预测，",
    "vocabulary": [
      "all of a sudden"
    ]
  },
  {
    "file": "screen056.png",
    "sha256": "d3d4c288f726f1d05e7baf4d2cd70df4ce95d9a2472845e1e2986e3650466712",
    "k": 52,
    "part": 2,
    "parts": 2,
    "role": "body",
    "en": "you can just keep listening to the lecture and not lose the idea of what’s going on.",
    "zh": "就能继续跟上讲座，而不会失去对当前内容的理解。",
    "vocabulary": [
      "lose"
    ]
  },
  {
    "file": "screen057.png",
    "sha256": "c5939da0f5f7edf884efb8ecdccac5694e5160d498b58eb1609ed5bba634d5f0",
    "k": 53,
    "part": 1,
    "parts": 1,
    "role": "body",
    "en": "So predicting is important to help you overcome outside noise and inside noise.",
    "zh": "所以，预测对于克服外部噪声和内心干扰都很重要。",
    "vocabulary": [
      "overcome"
    ]
  },
  {
    "file": "screen058.png",
    "sha256": "21c4a3313b8691d930acab5587a461f533b45390ce9a5a69dd48ce21e60e1e6a",
    "k": 54,
    "part": 1,
    "parts": 1,
    "role": "body",
    "en": "And another reason that predicting is important is because it saves you time.",
    "zh": "预测之所以重要，还有一个原因，那就是它能节省时间。",
    "vocabulary": [
      "save"
    ]
  },
  {
    "file": "screen059.png",
    "sha256": "8e8826beaa39795a11017317d2ec6dbe009a04185f5435f3801480dc1e3eb229",
    "k": 55,
    "part": 1,
    "parts": 2,
    "role": "body",
    "en": "Now when you listen you need time to think about the information, relate it to old ideas, take notes, ",
    "zh": "听讲时，你需要时间来思考信息、把它与已有的想法联系起来，以及记笔记；",
    "vocabulary": [
      "relate"
    ]
  },
  {
    "file": "screen060.png",
    "sha256": "6e975df0f12527cbe85f8e3016d38ae826c5940b84fac3e2ed7ec5d179e47369",
    "k": 55,
    "part": 2,
    "parts": 2,
    "role": "body",
    "en": "and if you’re only keeping up with what I’m saying or what the lecturer’s saying, you have no time to do that.",
    "zh": "如果你只是勉强跟上我或讲课人的讲话，就没有时间做这些事了。",
    "vocabulary": [
      "keep up with"
    ]
  },
  {
    "file": "screen061.png",
    "sha256": "80e15cb6b4e8e7891fc9a7e6b438d028b7de7f45c97a4b90869f04e3ae13c3ac",
    "k": 56,
    "part": 1,
    "parts": 2,
    "role": "body",
    "en": "And I’ll bet a lot of you are having that problem right now because it’s so hard just to follow everything I’m saying, ",
    "zh": "我敢说，你们中很多人现在就有这个问题：光是跟上我说的全部内容，就已经很费力了，",
    "vocabulary": [
      "follow"
    ]
  },
  {
    "file": "screen062.png",
    "sha256": "c6838448314249e8040607458e8497d3e56211dbd933c93eb16897c6ada5243a",
    "k": 56,
    "part": 2,
    "parts": 2,
    "role": "body",
    "en": "that you don’t have time to note down ideas.",
    "zh": "因而没有时间记下要点。",
    "vocabulary": [
      "note down"
    ]
  },
  {
    "file": "screen063.png",
    "sha256": "99b44dac9b115cb4eceb595c21af982d19aafbe602a5eed58116b2ae2112cd5d",
    "k": 57,
    "part": 1,
    "parts": 1,
    "role": "body",
    "en": "So predicting saves you time.",
    "zh": "因此，预测可以节省时间。",
    "vocabulary": [
      "predict"
    ]
  },
  {
    "file": "screen064.png",
    "sha256": "0ea6a4ad0b90b87e8f23113ab7fa8a18d8865c5f04c2c88fefe79a5e0d580152",
    "k": 58,
    "part": 1,
    "parts": 1,
    "role": "body",
    "en": "If you can guess what I’m going to say, you're able to take notes, you’re able to think, you have more time.",
    "zh": "如果你能猜到我接下来会说什么，就能记笔记，也能进行思考，你就拥有更多时间。",
    "vocabulary": [
      "take notes"
    ]
  },
  {
    "file": "screen065.png",
    "sha256": "9a70604bbe414ec9083a6b8b4c349bab3bde6eb9f3534fad2270a65b07a32d8e",
    "k": 59,
    "part": 1,
    "parts": 1,
    "role": "body",
    "en": "OK?",
    "zh": "明白吗？",
    "vocabulary": [
      "OK"
    ]
  },
  {
    "file": "screen066.png",
    "sha256": "e895de3879a6ee59bc254c07d90294efbeedc7ea657058d4b673aa178288665a",
    "k": 60,
    "part": 1,
    "parts": 1,
    "role": "body",
    "en": "And there are two types of predictions that you can make: predictions of content and predictions of organization.",
    "zh": "你可以作出两类预测：对内容的预测，以及对组织结构的预测。",
    "vocabulary": [
      "organization"
    ]
  },
  {
    "file": "screen067.png",
    "sha256": "6d106c1039fd6d6bfd4f248ab368191b4c6280d16f4ec7a67ec769bc8e1daa90",
    "k": 61,
    "part": 1,
    "parts": 1,
    "role": "body",
    "en": "Let me give you an example in terms of content.",
    "zh": "我先举一个预测内容的例子。",
    "vocabulary": [
      "in terms of"
    ]
  },
  {
    "file": "screen068.png",
    "sha256": "775c5a67cd6e47bf3a29606c8edeaf275420b4363ab95ee22ba63daea21e17c0",
    "k": 62,
    "part": 1,
    "parts": 1,
    "role": "body",
    "en": "If you hear the words “Because he loved to cook, his favorite room was...” what would you expect?",
    "zh": "如果你听到“因为他喜欢做饭，他最喜欢的房间是……”这些话，你会预期接下来出现什么词？",
    "vocabulary": [
      "expect"
    ]
  },
  {
    "file": "screen069.png",
    "sha256": "5c146a656b65fe408065ac3bb541039d86d5c9bc371781c45f32d160e5f67123",
    "k": 63,
    "part": 1,
    "parts": 1,
    "role": "body",
    "en": "Kitchen.",
    "zh": "厨房。",
    "vocabulary": [
      "kitchen"
    ]
  },
  {
    "file": "screen070.png",
    "sha256": "3b5d5ce67bd89d337ae95eb07e8ad56f9a272f6f982dd9165bacf82a18befc93",
    "k": 64,
    "part": 1,
    "parts": 1,
    "role": "body",
    "en": "You can guess this because you know people cook in the kitchen.",
    "zh": "你能猜到这一点，是因为你知道人们通常在厨房里做饭。",
    "vocabulary": [
      "guess"
    ]
  },
  {
    "file": "screen071.png",
    "sha256": "63f59df4358816770c8c55ee6ad336131dfed12b701cec2f6293b5243d9c175f",
    "k": 65,
    "part": 1,
    "parts": 1,
    "role": "body",
    "en": "OK?",
    "zh": "明白吗？",
    "vocabulary": [
      "OK"
    ]
  },
  {
    "file": "screen072.png",
    "sha256": "f21b0e04614bcfe4c57c580398c40d2660a270807170463c13302d3e8cc1d7b2",
    "k": 66,
    "part": 1,
    "parts": 1,
    "role": "body",
    "en": "And you can also predict organization.",
    "zh": "你也可以预测讲话的组织结构。",
    "vocabulary": [
      "organization"
    ]
  },
  {
    "file": "screen073.png",
    "sha256": "70cf5ab487b623acf2089dba0820739cd174ad91add751fd62f90cb5552926a4",
    "k": 67,
    "part": 1,
    "parts": 1,
    "role": "body",
    "en": "So if I was going to tell you a story, you'd expect me to tell you why the story is important, give you a setting for the story.",
    "zh": "比如，如果我要给你讲一个故事，你就会期待我先说明这个故事为什么重要，并交代故事发生的背景。",
    "vocabulary": [
      "setting"
    ]
  },
  {
    "file": "screen074.png",
    "sha256": "0881735559c4d59b36a6572648611b3a7f10cd93f72ae7ffa6d98eb80098e5b4",
    "k": 68,
    "part": 1,
    "parts": 1,
    "role": "body",
    "en": "So you have expectations of what the speaker is going to talk about and how the speaker will organize his or her words.",
    "zh": "因此，对于说话人接下来要谈什么，以及他或她会如何组织语言，你都会有所预期。",
    "vocabulary": [
      "expectation"
    ]
  },
  {
    "file": "screen075.png",
    "sha256": "8130997af13c6c37600f4391efb9dd133e068d01d6bc8dd1d1cd8a8dd5a9f39e",
    "k": 69,
    "part": 1,
    "parts": 2,
    "role": "body",
    "en": "Now let’s come to the last thing a listener must do: the listener must evaluate, as he or she is listening, ",
    "zh": "现在来看听众必须做的最后一件事：边听边评价，",
    "vocabulary": [
      "evaluate"
    ]
  },
  {
    "file": "screen076.png",
    "sha256": "f492da4624de2b58c646b91cfd2e337e58daedc1632a96a1bf122719d8b6d2f4",
    "k": 69,
    "part": 2,
    "parts": 2,
    "role": "body",
    "en": "decide what’s important, what’s not, decide how something relates to something else.",
    "zh": "判断什么重要、什么不重要，以及某件事与另一件事之间有什么联系。",
    "vocabulary": [
      "relate to"
    ]
  },
  {
    "file": "screen077.png",
    "sha256": "3ca5432b5ffe1e06d17aa31b4764fbefacd06ecfd6f3d6e87ba4351f8ab09a1a",
    "k": 70,
    "part": 1,
    "parts": 1,
    "role": "body",
    "en": "OK?",
    "zh": "明白吗？",
    "vocabulary": [
      "OK"
    ]
  },
  {
    "file": "screen078.png",
    "sha256": "f83c535bb88bd8d4eef8170bdaad5da10886ff5d6ae42b9401e0b5eb12f39de4",
    "k": 71,
    "part": 1,
    "parts": 1,
    "role": "body",
    "en": "There are again two reasons for this.",
    "zh": "这样做同样有两个原因。",
    "vocabulary": [
      "reason"
    ]
  },
  {
    "file": "screen079.png",
    "sha256": "6484289d6f8c3bf1c060e424117b14ea901259e4f5ca4262011e29ec14ed7632",
    "k": 72,
    "part": 1,
    "parts": 1,
    "role": "body",
    "en": "The first one is evaluating helps you to decide what to take notes about: what's important to write down? what’s not important to write down?",
    "zh": "第一个原因是，评价能够帮助你决定哪些内容值得记笔记：什么值得写下来？什么不值得写下来？",
    "vocabulary": [
      "write down"
    ]
  },
  {
    "file": "screen080.png",
    "sha256": "49402234fcb0ce4b51d9d4a13a957532ccbff029c7bcdf29e07f7d3390d9a554",
    "k": 73,
    "part": 1,
    "parts": 1,
    "role": "body",
    "en": "And the second reason is that evaluating helps you to keep information.",
    "zh": "第二个原因是，评价有助于你记住信息。",
    "vocabulary": [
      "keep information"
    ]
  },
  {
    "file": "screen081.png",
    "sha256": "e60d162489f7f576b293e9bae750ca15c19e70c93c5611e2428a1fbc6b584998",
    "k": 74,
    "part": 1,
    "parts": 1,
    "role": "body",
    "en": "Studies have shown that we retain more information if ideas are connected to one another rather than just individually remembered.",
    "zh": "研究表明，如果各种想法彼此关联，而不是各自孤立地记忆，我们就能记住更多信息。",
    "vocabulary": [
      "retain"
    ]
  },
  {
    "file": "screen082.png",
    "sha256": "15d60ebe6264bb8fedb77e30af88bee3c5b66fc8ea4f2623ca7197484137a5d9",
    "k": 75,
    "part": 1,
    "parts": 1,
    "role": "body",
    "en": "So for example, if I give you five ideas that are not related to one another, that’s much more difficult to remember than five ideas that are related.",
    "zh": "比如，我给你五个彼此不相关的想法，它们会比五个相互关联的想法难记得多。",
    "vocabulary": [
      "related to"
    ]
  },
  {
    "file": "screen083.png",
    "sha256": "2eafb1045b64fd72c099896583cd8f3a3baa9206890e96992f575ae7848bbd64",
    "k": 76,
    "part": 1,
    "parts": 1,
    "role": "body",
    "en": "So you can see evaluating helps you to remember information better because it connects ideas to one another.",
    "zh": "所以，你可以看到，评价把各种想法联系在一起，因此能帮助你更好地记住信息。",
    "vocabulary": [
      "connect"
    ]
  },
  {
    "file": "screen084.png",
    "sha256": "81a399814785c1e607b91eba7a9c16d2971e9474161859449ae0ff24076241ab",
    "k": 77,
    "part": 1,
    "parts": 1,
    "role": "body",
    "en": "OK.",
    "zh": "好。",
    "vocabulary": [
      "OK"
    ]
  },
  {
    "file": "screen085.png",
    "sha256": "a2636a3f9bc2f874bac3ea70398207890790fd95671941b7c255cf0216e3137b",
    "k": 78,
    "part": 1,
    "parts": 2,
    "role": "body",
    "en": "From what I’ve said so far, you can see there’s a lot involved in listening to lectures: ",
    "zh": "从刚才的内容可以看出，听讲座涉及很多事情：",
    "vocabulary": [
      "involved in"
    ]
  },
  {
    "file": "screen086.png",
    "sha256": "10b314d88081323f0fced64110cbe168eff533a24d2cb180885212508bc1e330",
    "k": 78,
    "part": 2,
    "parts": 2,
    "role": "body",
    "en": "language awareness, adding information, making predictions and evaluations.",
    "zh": "语言意识、补充信息、进行预测和作出评价。",
    "vocabulary": [
      "awareness"
    ]
  },
  {
    "file": "screen087.png",
    "sha256": "1cefbfa3f09baaea2dd3e4491afacf7af10b35e097a13f945d22ed2b609a4c7d",
    "k": 79,
    "part": 1,
    "parts": 1,
    "role": "body",
    "en": "I hope these will be useful to you in lecture comprehension.",
    "zh": "我希望这些方法能有助于你们理解讲座。",
    "vocabulary": [
      "comprehension"
    ]
  },
  {
    "file": "screen088.png",
    "sha256": "a053a66e5a90e7862901110e41f755a558cd7302ce27b71d4836da7589b076e4",
    "k": 80,
    "part": 1,
    "parts": 1,
    "role": "transition",
    "en": "Now, you have three minutes to check your work.",
    "zh": "现在你有三分钟检查作答。",
    "vocabulary": [
      "check"
    ]
  },
  {
    "file": "screen089.png",
    "sha256": "0f880f77390ec161926796ee42186c30de02bbcda009f03f344a80ffb5c4048f",
    "k": 81,
    "part": 1,
    "parts": 1,
    "role": "transition",
    "en": "This is the end of Section A mini-lecture.",
    "zh": "A节短讲到此结束。",
    "vocabulary": [
      "end"
    ]
  }
]
