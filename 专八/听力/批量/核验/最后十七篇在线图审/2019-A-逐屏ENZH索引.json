    ]
  },
  {
    "file": "screen010.png",
    "sha256": "37e6dcc51e8ec0075a2e4370ee6746410d4614b85658d5cca2a626bc0ea3b547",
    "k": 9,
    "part": 1,
    "parts": 1,
