    "k": 37,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "Thank you very much for staying with us today.",
    "zh": "非常感谢你今天和我们聊了这么多。",
    "vocabulary": [
      "staying with"
    ]
  },
