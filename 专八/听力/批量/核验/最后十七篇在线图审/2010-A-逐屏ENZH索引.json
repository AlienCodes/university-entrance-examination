    ]
  },
  {
    "file": "screen007.png",
    "sha256": "19c6514566d5a62d19d781ad9f52082257d236090f8ae4086aa5ad0f4dbd9394",
    "k": 6,
    "part": 1,
    "parts": 1,
    "role": "instruction",
    "en": "You will hear the mini-lecture once only.",
    "zh": "这段短讲只播放一遍。",
    "vocabulary": [
      "once"
    ]
  },
  {
    "file": "screen008.png",
    "sha256": "7ebcd938f884e56950af3c74c79b54f74174f5e77c1b6bf4ba4a3702e8e9eb38",
    "k": 7,
    "part": 1,
    "parts": 1,
    "role": "instruction",
    "en": "While listening to the mini-lecture, please complete the gap-filling task on Answer Sheet I, and write no more than three words for each gap.",
    "zh": "请边听短讲，边完成答题卡一上的填空任务；每空填写不超过三个词。",
    "vocabulary": [
      "gap-filling"
    ]
  },
  {
    "file": "screen009.png",
    "sha256": "6b85428eb2c2c50e43a124fd1ee79097e9b615b43cd9320240978c37c1d04833",
    "k": 8,
    "part": 1,
    "parts": 1,
    "role": "instruction",
    "en": "Make sure the word or words you fill in is or are both grammatically and semantically acceptable.",
    "zh": "请确保填入的词在语法和语义上都恰当。",
    "vocabulary": [
      "acceptable"
    ]
  },
  {
    "file": "screen010.png",
    "sha256": "8b3042cde364d0673c207dfa388f1cbc8de08383a3d5cd090c47597a54963604",
    "k": 9,
    "part": 1,
    "parts": 1,
    "role": "instruction",
    "en": "You may use the blank sheet for note-taking.",
    "zh": "你可以用空白纸做笔记。",
    "vocabulary": [
      "blank"
    ]
  },
  {
    "file": "screen011.png",
    "sha256": "f256e8b7a54e6c708f269226c728c02c055b98c3361f2e6758cb7fa9d7f4fd76",
    "k": 10,
    "part": 1,
    "parts": 1,
    "role": "instruction",
    "en": "You have 30 seconds to preview the gap-filling task.",
    "zh": "你有三十秒钟预览填空任务。",
    "vocabulary": [
      "preview"
    ]
  },
  {
    "file": "screen012.png",
    "sha256": "f4d8e97bd75d0998cdfbd3e19487069ac983b95c5c568a84b48d5e39d184d3f6",
    "k": 11,
    "part": 1,
    "parts": 1,
    "role": "transition",
    "en": "Now listen to the mini-lecture.",
    "zh": "现在请听短讲。",
    "vocabulary": [
      "listen"
    ]
  },
  {
    "file": "screen013.png",
    "sha256": "e953a25581fd6ffc73b437db4e06e6e058dbb6adfa8e3d80a4f9bb7ce4ce9570",
    "k": 12,
    "part": 1,
    "parts": 1,
    "role": "transition",
    "en": "When it is over, you will be given Three minutes to check your work.",
    "zh": "短讲结束后，你将有三分钟检查作答。",
    "vocabulary": [
      "check"
    ]
  },
  {
    "file": "screen014.png",
    "sha256": "5d79d1ceb49e47aebd339ba92abea77ef2072d585c188eb6032bc7f824c905be",
    "k": 13,
    "part": 1,
    "parts": 1,
    "role": "transition",
    "en": "Paralinguistic Features of Language.",
    "zh": "语言的副语言特征。",
    "vocabulary": [
      "paralinguistic"
    ]
  },
  {
    "file": "screen015.png",
    "sha256": "5036f43762db22907c847dc509c4ad34d84cabd4ae1e378151047bf316a1a86a",
    "k": 14,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "Good morning, everyone.",
    "zh": "大家早上好。",
    "vocabulary": [
      "Good morning"
    ]
  },
  {
    "file": "screen016.png",
    "sha256": "ef9cfa9b9772d4603f0977da1a61d7470b35451451fda82b513794943876f19d",
    "k": 15,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "Today we’ll continue our discussion on describing language.",
    "zh": "今天我们继续讨论如何描述语言。",
    "vocabulary": [
      "describe"
    ]
  },
  {
    "file": "screen017.png",
    "sha256": "bf57749e60a9d8f32282c032dcabe04062d84c4b1d49237c1151dba57f8db13d",
    "k": 16,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "Last week we examined such features of, of language as grammar, vocabulary, the sounds of language, etc.",
    "zh": "上周，我们考察了语法、词汇、语音等语言特征。",
    "vocabulary": [
      "vocabulary"
    ]
  },
  {
    "file": "screen018.png",
    "sha256": "d0e9a06735935a4085694f8475e1c8a5625ebc88bbb56cbcd0fb2c8cd329f8bf",
    "k": 17,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "In this lecture, we’ll look at another important aspect of language.",
    "zh": "这堂课，我们要了解语言的另一个重要方面。",
    "vocabulary": [
      "aspect"
    ]
  },
  {
    "file": "screen019.png",
    "sha256": "25076292d9468c636ab74546587e0f37ece12ad377da0692e54e084fdd9ff926",
    "k": 18,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "Perhaps some of you may wonder what is this important aspect of language.",
    "zh": "也许有人会想，这个重要方面到底是什么呢？",
    "vocabulary": [
      "wonder"
    ]
  },
  {
    "file": "screen020.png",
    "sha256": "18ac66187da7425c26fa66345d7bcac22d15fad5ef7aa261022e98b969ed5005",
    "k": 19,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "Let me tell you.",
    "zh": "我来告诉大家。",
    "vocabulary": [
      "tell"
    ]
  },
  {
    "file": "screen021.png",
    "sha256": "be426e9653c28a70d979da7dbdb117de4c233757cb49febd70d59fb36252c4d8",
    "k": 20,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "It refers to features of communication that takes place without the use of grammar or vocabulary.",
    "zh": "它指的是那些不借助语法或词汇而实现的交流特征。",
    "vocabulary": [
      "refer to"
    ]
  },
  {
    "file": "screen022.png",
    "sha256": "c66c2432b912afca0f0c3d97b4d2bd352d04401940e34ef475a6ecdf2bddf439",
    "k": 21,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "They are called “paralinguistic features of language”.",
    "zh": "它们被称为“语言的副语言特征”。",
    "vocabulary": [
      "paralinguistic"
    ]
  },
  {
    "file": "screen023.png",
    "sha256": "e39ff3b19aa9eb00d6df7e3da639ea25e1c23bc64351c3aca83f401c547276a5",
    "k": 22,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "These features fall into two broad categories: those that involve the voice and those that involve the body.",
    "zh": "这些特征大致分成两类：一类与声音有关，另一类与身体有关。",
    "vocabulary": [
      "fall into"
    ]
  },
  {
    "file": "screen024.png",
    "sha256": "1e675ebaa405370a6b274c141a6dd9c8194f19b83448b7a6c9fa106634c3ad3f",
    "k": 23,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "Now, the first category is what we call vocal paralinguistic features.",
    "zh": "第一类，就是我们所说的声音副语言特征。",
    "vocabulary": [
      "vocal"
    ]
  },
  {
    "file": "screen025.png",
    "sha256": "6c0871526afbaa79615b90174b8c3aeb54a0e561412218233882b13895327158",
    "k": 24,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "Vocal features are actually tones of voice.",
    "zh": "声音特征实际上就是不同的语气或声调。",
    "vocabulary": [
      "tones of voice"
    ]
  },
  {
    "file": "screen026.png",
    "sha256": "751de7230f5c931de1e827dc3b9143ef62f1059664fe753dad3a3095d6ef3f5a",
    "k": 25,
    "part": 1,
    "parts": 2,
    "role": null,
    "en": "While they are, perhaps, not central to meaning in communication in the same way as grammar or vocabulary, ",
    "zh": "虽然它们可能不像语法或词汇那样处于交流意义的核心，",
    "vocabulary": [
      "central"
    ]
  },
  {
    "file": "screen027.png",
    "sha256": "17cab2b2fd09139afdccb07f78a1dafaca17da34bdb635c06dc6a1692672f120",
    "k": 25,
    "part": 2,
    "parts": 2,
    "role": null,
    "en": "they may, nevertheless, convey attitude or intention in some way.",
    "zh": "却仍然能够在某种程度上传达态度或意图。",
    "vocabulary": [
      "convey"
    ]
  },
  {
    "file": "screen028.png",
    "sha256": "459cc3580db7da20893a962c5bef1ac45d766f33b29b4d8566d499d18dad4c80",
    "k": 26,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "Let me give you some examples.",
    "zh": "我来举几个例子。",
    "vocabulary": [
      "example"
    ]
  },
  {
    "file": "screen029.png",
    "sha256": "939df83335db61dacfff92e39bdfef053ad3c2de56b401c1c03f426e6413864f",
    "k": 27,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "The first is whispering, which indicates the need for secrecy.",
    "zh": "第一个例子是低声说话，这表明有保密的需要。",
    "vocabulary": [
      "whispering"
    ]
  },
  {
    "file": "screen030.png",
    "sha256": "62f116b2a039cc2589c6816198af310a2a9b4ecd6df847b13cf085d80c6c27ca",
    "k": 28,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "The second is breathiness.",
    "zh": "第二个是带有气息的说话声。",
    "vocabulary": [
      "breathiness"
    ]
  },
  {
    "file": "screen031.png",
    "sha256": "c24c4d74de9b8dff1bf10f09cd1e5d22b04a8ee634699f7b0e4b35fb9c6718aa",
    "k": 29,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "This is to show deep emotion.",
    "zh": "这是为了表达强烈的感情。",
    "vocabulary": [
      "emotion"
    ]
  },
  {
    "file": "screen032.png",
    "sha256": "ff4e13f2df229dd9c0083f95de9fc46ce41fa1c78b3ee382239eb30ab1dde6cc",
    "k": 30,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "The third is huskiness, which is to show unimportance.",
    "zh": "第三个是沙哑的声音，用来表示事情并不重要。",
    "vocabulary": [
      "huskiness"
    ]
  },
  {
    "file": "screen033.png",
    "sha256": "6a9a6b30b7cd4c8e1df35367e9f8689b92826cce259a0a44b0d54910575156ab",
    "k": 31,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "The fourth is nasality.",
    "zh": "第四个是鼻音。",
    "vocabulary": [
      "nasality"
    ]
  },
  {
    "file": "screen034.png",
    "sha256": "c7098b51d7a5bfbfaa49958ae53d9a7a647852c90ac62568aefc4226adde92e9",
    "k": 32,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "This, um, is to indicate anxiety.",
    "zh": "这，嗯，是用来表达焦虑的。",
    "vocabulary": [
      "anxiety"
    ]
  },
  {
    "file": "screen035.png",
    "sha256": "0f75b3bb25a534068b1998258daebd09f059ac48ccfe57185f110290bbdc8438",
    "k": 33,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "The last is extra lip rounding, which expresses greater intimacy, especially with babies, for example.",
    "zh": "最后一个例子是把嘴唇拢得更圆，这表示更加亲昵，例如人们对婴儿说话时就会这样。",
    "vocabulary": [
      "intimacy"
    ]
  },
  {
    "file": "screen036.png",
    "sha256": "6c6b66a01bd83ac274279687e9b291a919cd22ce2088452480ae8aa02bd5279c",
    "k": 34,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "So we can see that there are a number of ways of altering our tone of voice and when we do this consciously, we do it to create different effects in communication.",
    "zh": "因此，我们可以看到，改变语气的方式有很多；有意识地这样做，是为了在交流中产生不同的效果。",
    "vocabulary": [
      "consciously"
    ]
  },
  {
    "file": "screen037.png",
    "sha256": "c5a8d38d6075b4a281624995c8d6020253e6ec9b0c275a7eea155a31d1a94b23",
    "k": 35,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "Now, let’s come to the second category, physical paralinguistic features, which involves the body.",
    "zh": "现在我们来讲第二类，也就是与身体有关的身体副语言特征。",
    "vocabulary": [
      "physical"
    ]
  },
  {
    "file": "screen038.png",
    "sha256": "32a95f778321fbf83511e78ec2b14469b8ef97bffd086515f58cfed6d584e332",
    "k": 36,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "In addition to conveying meanings with tone of voice, we can also express our intention through the ways in which we use our bodies.",
    "zh": "除了通过语气传达意义，我们还可以通过运用身体的方式表达意图。",
    "vocabulary": [
      "intention"
    ]
  },
  {
    "file": "screen039.png",
    "sha256": "79b1f8279310c53fc81abf468a1fd4b2fde6e7d371c12c0417fef7a28bc2e87f",
    "k": 37,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "You may ask: what are the ways, then?",
    "zh": "你们也许会问，那么具体有哪些方式呢？",
    "vocabulary": [
      "way"
    ]
  },
  {
    "file": "screen040.png",
    "sha256": "46357e1c08078d8ef955f9602d924c033629fdc21b8c2e40b89a7d0dc32a602c",
    "k": 38,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "Let me cite some brief examples.",
    "zh": "我来简单举几个例子。",
    "vocabulary": [
      "cite"
    ]
  },
  {
    "file": "screen041.png",
    "sha256": "3924e69644dc85026b43e88694b3461e69b532cf00020d98032a36dcb217ad1d",
    "k": 39,
    "part": 1,
    "parts": 2,
    "role": null,
    "en": "The expression on our face, the gestures we make and even proximity or way we sit, ",
    "zh": "面部表情、手势，甚至我们与别人之间的距离或坐姿，",
    "vocabulary": [
      "proximity"
    ]
  },
  {
    "file": "screen042.png",
    "sha256": "cb4ccb799f68ec71376ba597b8139df96520792d4dfe25a42533417483000054",
    "k": 39,
    "part": 2,
    "parts": 2,
    "role": null,
    "en": "are some of the ways we send powerful messages about how we feel, or what we mean.",
    "zh": "都能有力地传达自己的感受或意思。",
    "vocabulary": [
      "powerful messages"
    ]
  },
  {
    "file": "screen043.png",
    "sha256": "66a540fb2d6ca4cee4c424d687c810b7fc17cb09f5433ca04249db248b7de141",
    "k": 40,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "Let me explain some of these in more detail.",
    "zh": "我来进一步解释其中的几项。",
    "vocabulary": [
      "in more detail"
    ]
  },
  {
    "file": "screen044.png",
    "sha256": "9ec7abf1ec7015f4832bb3c08a7028c5ad12b1972bb722a7ad71b5e0108a01da",
    "k": 41,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "First, facial expression.",
    "zh": "首先是面部表情。",
    "vocabulary": [
      "facial expression"
    ]
  },
  {
    "file": "screen045.png",
    "sha256": "69995ca4e61bf6a76d296618995a228ea2447afe44eecb17478ff7cf43902c27",
    "k": 42,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "Facial expression is a powerful conveyer of meaning.",
    "zh": "面部表情是传达意义的有力方式。",
    "vocabulary": [
      "conveyer"
    ]
  },
  {
    "file": "screen046.png",
    "sha256": "546bbdc8ef5e9738478f356fe2c2aaafe44b1c78f2ae3346476527e94cd6a4b2",
    "k": 43,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "We all know smiling is an almost universal signal of pleasure or welcome.",
    "zh": "我们都知道，微笑几乎是表示愉快或欢迎的通用信号。",
    "vocabulary": [
      "universal"
    ]
  },
  {
    "file": "screen047.png",
    "sha256": "30c87739aba7a087b4c038067ed845a6a267a3f1235b6c191add010bf3322dd3",
    "k": 44,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "But there are other facial expressions that may not be so common.",
    "zh": "不过，也有一些面部表情没有那么普遍。",
    "vocabulary": [
      "facial expression"
    ]
  },
  {
    "file": "screen048.png",
    "sha256": "388a44f641a0b26546f133b591795b0c46e69366cb95914922c2a343d0b57b9c",
    "k": 45,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "For instance, raising eye-brows suggests that you are surprised or interested in something.",
    "zh": "例如，扬起眉毛表示你对某件事感到惊讶或感兴趣。",
    "vocabulary": [
      "raise eye-brows"
    ]
  },
  {
    "file": "screen049.png",
    "sha256": "d556b602fe18e3c439a2cdccc552235dd3270f6eca3606c3b5a5a4ada306cc49",
    "k": 46,
    "part": 1,
    "parts": 3,
    "role": null,
    "en": "Other facial actions, such as biting your lip, which indicates that you are deep in thinking, or are uncertain about something; ",
    "zh": "其他面部动作，比如咬嘴唇，表示你在深思或对某事拿不准；",
    "vocabulary": [
      "uncertain"
    ]
  },
  {
    "file": "screen050.png",
    "sha256": "41cab0608dc0c4e1cfe8f13a92f9916a03a8d1115be6aa68a093389792528fa6",
    "k": 46,
    "part": 2,
    "parts": 3,
    "role": null,
    "en": "compressing the lips, which show that you are making decisions; ",
    "zh": "抿紧嘴唇表示你在作决定；",
    "vocabulary": [
      "compress"
    ]
  },
  {
    "file": "screen051.png",
    "sha256": "717aa387d0a53326be9dc5ab80f25180f9a47f81a94f5b846a127791d99ece33",
    "k": 46,
    "part": 3,
    "parts": 3,
    "role": null,
    "en": "and a visible clenching of the teeth, to show that you are angry, are all powerful conveyers of meaning, too.",
    "zh": "明显地咬紧牙齿，则表示你很生气。这些动作也都能有力地传达意义。",
    "vocabulary": [
      "clench"
    ]
  },
  {
    "file": "screen052.png",
    "sha256": "f21161e77b974ce1c76ec05be9209b1feb3581a495c1fb0617baea30064abbe2",
    "k": 47,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "The second in this category is gesture.",
    "zh": "这一类中的第二项是手势。",
    "vocabulary": [
      "gesture"
    ]
  },
  {
    "file": "screen053.png",
    "sha256": "708e30bb5598533252c7a3c3af5348968dae1a041aa3c4336d1f9c4fb38e0297",
    "k": 48,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "You see, we use gesture to indicate a wide range of meanings, though I have to emphasize that the actual gestures we use may be specific to particular cultures.",
    "zh": "你看，我们用手势来表达各种各样的意思，不过我要强调，具体的手势可能只属于某些特定文化。",
    "vocabulary": [
      "specific to"
    ]
  },
  {
    "file": "screen054.png",
    "sha256": "1407b73b564ea5bff89033a1216ec3212aa758df604af800a6b992fe7711356a",
    "k": 49,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "That is to say different cultures have their own favorite gestures in conveying meaning.",
    "zh": "也就是说，不同文化各有自己惯用的手势来传达意思。",
    "vocabulary": [
      "That is to say"
    ]
  },
  {
    "file": "screen055.png",
    "sha256": "1c7e3c9ac5aec5d2951d37512c7060a869b1f9c2c5b56559cff72473cfd3a4f1",
    "k": 50,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "Here, a few examples may show you how powerful gestures can be.",
    "zh": "下面的几个例子，可以说明手势能发挥多大的作用。",
    "vocabulary": [
      "powerful"
    ]
  },
  {
    "file": "screen056.png",
    "sha256": "e7e3e43fa1ef549bdb0bc78abb143a0a77f855521c8c6995e77504b248e029f2",
    "k": 51,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "In British English behavior, shrugging shoulders may indicate an attitude of “I don’t care”, or “I don’t know”.",
    "zh": "在英国人的行为习惯中，耸肩可能表示“我不在乎”或“我不知道”。",
    "vocabulary": [
      "shrug shoulders"
    ]
  },
  {
    "file": "screen057.png",
    "sha256": "5d537c020ff9365c3bd4e760b1acd5f13146e321b96490fe3856aa7860cb8db6",
    "k": 52,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "Crossing your arms may indicate relaxation.",
    "zh": "交叉双臂可能表示放松。",
    "vocabulary": [
      "relaxation"
    ]
  },
  {
    "file": "screen058.png",
    "sha256": "68f2f9e4a5aa5984ce2f183069606d5bb8c751ab99e768815040f6c854d66aad",
    "k": 53,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "But it can also powerfully show you are bored.",
    "zh": "但这个动作也可能非常明确地表示你感到厌烦。",
    "vocabulary": [
      "bored"
    ]
  },
  {
    "file": "screen059.png",
    "sha256": "63286103b49e7ebfb08edf92c37aa47f984ce3c2c85976469f8eb3b0ce4f4954",
    "k": 54,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "Waving can mean welcome and farewell whereas scratching your head may indicate that you are at a loss.",
    "zh": "挥手可以表示欢迎或告别，而挠头则可能表示你不知所措。",
    "vocabulary": [
      "at a loss"
    ]
  },
  {
    "file": "screen060.png",
    "sha256": "a255b624a92d534a78db3ee6e0ebac97d2acdf82f4f2ee8fa4fb6eac959bd168",
    "k": 55,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "In other cultures, placing your hand upon your heart is to indicate that you are telling the truth.",
    "zh": "在其他一些文化中，把手放在心口表示自己在说实话。",
    "vocabulary": [
      "tell the truth"
    ]
  },
  {
    "file": "screen061.png",
    "sha256": "ee67ce37a2d6a9cf3e62c1758019e194a1c5e869ac7c9150ffa3ac309effd9b0",
    "k": 56,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "Pointing your finger at your nose means it’s a secret.",
    "zh": "用手指指着自己的鼻子，表示这是个秘密。",
    "vocabulary": [
      "secret"
    ]
  },
  {
    "file": "screen062.png",
    "sha256": "0d7da5a4a6ec6feb99c2c733dcb357a417efcccd9565352a9a937229c67f30db",
    "k": 57,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "That’s why we say that gestures are culture-bound.",
    "zh": "因此，我们说手势受文化的制约。",
    "vocabulary": [
      "culture-bound"
    ]
  },
  {
    "file": "screen063.png",
    "sha256": "17d36863f6167acdb52322b50f6e6a3b47d4e55cbc6e795515feb5bd5315da8d",
    "k": 58,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "The third is proximity, posture and echoing.",
    "zh": "第三项是距离、姿态和姿态呼应。",
    "vocabulary": [
      "posture"
    ]
  },
  {
    "file": "screen064.png",
    "sha256": "019bcdd16a4446a29d818736b9520b5e215cc181dffaf4bdeadc3b7a500bece1",
    "k": 59,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "Proximity refers to the physical distance between speakers.",
    "zh": "距离是指交谈者之间的身体距离。",
    "vocabulary": [
      "physical distance"
    ]
  },
  {
    "file": "screen065.png",
    "sha256": "44e3377c5be04c73f38ef075ec10eabce0619588076651b5306a7c527eb9d0fb",
    "k": 60,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "This can indicate a number of things and can also be used to consciously send messages about intent.",
    "zh": "它能够表达多种意思，也可以用来有意识地传达意图。",
    "vocabulary": [
      "intent"
    ]
  },
  {
    "file": "screen066.png",
    "sha256": "a5b02c065ed65d9152781d92fd0399e227a23b486b4667b8fd3e2c76bd6c8ab6",
    "k": 61,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "Closeness, for example, indicates intimacy or threat to many speakers.",
    "zh": "例如，对许多交谈者而言，距离近表示亲密，也可能表示威胁。",
    "vocabulary": [
      "threat"
    ]
  },
  {
    "file": "screen067.png",
    "sha256": "f12a3fc5c6076beb7a36e3c3dc657d1919f774d485d57523cee956995cf7cf90",
    "k": 62,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "But distance may show formality, or lack of interest.",
    "zh": "而保持距离可能表示拘谨有礼，或缺乏兴趣。",
    "vocabulary": [
      "formality"
    ]
  },
  {
    "file": "screen068.png",
    "sha256": "734d7e14c24e08e90ecb30489e9066147cf09ac10988c7518f002a0554d1013b",
    "k": 63,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "Once again, I’d like to say, proximity is also both a matter of personal style, and is often culture-bound.",
    "zh": "我想再次强调，人际距离既与个人风格有关，也常常受到文化制约。",
    "vocabulary": [
      "personal style"
    ]
  },
  {
    "file": "screen069.png",
    "sha256": "c114dbb1b4fa607fbc03684b4a2bc671fe3f25c70438c73f285fa1c3a6b85b9c",
    "k": 64,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "So, what may seem normal to a speaker from one culture may appear unnecessarily close or distant to a speaker from another.",
    "zh": "因此，对某种文化背景的交谈者而言很正常的距离，在另一种文化背景的人看来，可能显得过近或过远。",
    "vocabulary": [
      "unnecessarily"
    ]
  },
  {
    "file": "screen070.png",
    "sha256": "bcf7fb3417fd9fc8a2c8d77b951a19d0216b9099402adf0fde36bd7471f6c67d",
    "k": 65,
    "part": 1,
    "parts": 2,
    "role": null,
    "en": "And standing close to someone may be quite appropriate in some situations such as an informal party, ",
    "zh": "站得离别人很近，在非正式聚会等场合可能很合适，",
    "vocabulary": [
      "appropriate"
    ]
  },
  {
    "file": "screen071.png",
    "sha256": "0e793a54c96455525f7186cabd43cd2258bc44253166919724a5c7d1aebd29b3",
    "k": 65,
    "part": 2,
    "parts": 2,
    "role": null,
    "en": "but completely out of place in other situations, such as a meeting with a superior.",
    "zh": "但在与上级开会等场合，就可能完全不妥。",
    "vocabulary": [
      "out of place"
    ]
  },
  {
    "file": "screen072.png",
    "sha256": "9df5c11fb01e795b39c1148621539ad435cb10bc286f8ad48aa8707587b8e8c7",
    "k": 66,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "Next, posture.",
    "zh": "接下来讲姿态。",
    "vocabulary": [
      "posture"
    ]
  },
  {
    "file": "screen073.png",
    "sha256": "93f9f016cf9a9bcf642214976b0a8faec8cc983e4c10430cb2964af0737d1161",
    "k": 67,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "Posture means the way in which someone holds his or her body, especially the back, shoulders and head, when standing, walking or sitting.",
    "zh": "姿态是指一个人在站立、行走或坐着时，身体，尤其是背部、肩部和头部所保持的姿势。",
    "vocabulary": [
      "posture"
    ]
  },
  {
    "file": "screen074.png",
    "sha256": "d5a152aab9a5c74454b1456f8abecea334a45e7428128afb2d5f5917fa632858",
    "k": 68,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "A few examples.",
    "zh": "下面举几个例子。",
    "vocabulary": [
      "example"
    ]
  },
  {
    "file": "screen075.png",
    "sha256": "50b2d752644354b6756c97b8015cc5948844b34fb11f7cef8a51e1eb3077b565",
    "k": 69,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "Hunched shoulders and a hanging head give a powerful indication of whether the person is happy or not.",
    "zh": "耸缩的肩膀和低垂的头，能明显反映一个人是否开心。",
    "vocabulary": [
      "hunched"
    ]
  },
  {
    "file": "screen076.png",
    "sha256": "9514157b99c1af5abe38ba5ee4f52197771b10aac40f35da34e99825f1f57429",
    "k": 70,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "A lowered head when speaking to a superior, with or without eye contact, can convey the appropriate relationship in some cultures.",
    "zh": "在某些文化中，与上级交谈时低下头，无论有没有眼神接触，都能恰当地体现双方的关系。",
    "vocabulary": [
      "superior"
    ]
  },
  {
    "file": "screen077.png",
    "sha256": "2e2f450ef3f6b133814f664777920bf0200e660553e56e1f815df8e8a5a663ba",
    "k": 71,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "On the other hand, direct level eye contact changes the nature of the interaction, and can be seen as either open or challenging.",
    "zh": "另一方面，平视对方的直接眼神接触，会改变互动的性质，既可能被理解为坦诚，也可能被理解为挑战。",
    "vocabulary": [
      "interaction"
    ]
  },
  {
    "file": "screen078.png",
    "sha256": "bf1d890db38b463d4cd2c038e3f20369b1187f324b95587b611b5d098d9852eb",
    "k": 72,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "Last, echoing.",
    "zh": "最后讲姿态呼应。",
    "vocabulary": [
      "echoing"
    ]
  },
  {
    "file": "screen079.png",
    "sha256": "aa79c5b002ef48e2f53841edea94726cbde62f6e788dbe8c53c104c9fdbc64e9",
    "k": 73,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "Now, what is echoing?",
    "zh": "那么，什么是姿态呼应呢？",
    "vocabulary": [
      "echoing"
    ]
  },
  {
    "file": "screen080.png",
    "sha256": "85c4785f99bdbd67fdb8f55afe8beeccf05894ad42006634ed1e96d778e56206",
    "k": 74,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "Let me start with an example.",
    "zh": "我先举个例子。",
    "vocabulary": [
      "start with"
    ]
  },
  {
    "file": "screen081.png",
    "sha256": "7214c09e62b3b38450c346896e800dea4e83c70057fccf3739e2fe95c8e5bf3d",
    "k": 75,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "Some of you may have noticed this phenomenon in your experience.",
    "zh": "你们中有些人也许在自己的经历中注意到过这种现象。",
    "vocabulary": [
      "phenomenon"
    ]
  },
  {
    "file": "screen082.png",
    "sha256": "17b569aaaf42c6fb205509a0da11583391cde4deeca0637fae2ec6e1a024b247",
    "k": 76,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "When two people are keen to agree with each other, they would likely, though unconsciously, adopt the same posture, as if in imitation of each other.",
    "zh": "当两个人很想与对方达成一致时，往往会不自觉地采用相同的姿态，仿佛在相互模仿。",
    "vocabulary": [
      "adopt"
    ]
  },
  {
    "file": "screen083.png",
    "sha256": "178176e34fe6bc1334753f44824b3d6367cef99aca4f5e378bf4aa612f807c03",
    "k": 77,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "They sit or stand in the same manner.",
    "zh": "他们会以相同的方式坐着或站着。",
    "vocabulary": [
      "in the same manner"
    ]
  },
  {
    "file": "screen084.png",
    "sha256": "209634eb1ffc6fc4788a4c7147ccbb66aa84d2c206bbd0c75a0177539064ef34",
    "k": 78,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "When used in this way, echoing appears to complement the verbal communication.",
    "zh": "以这种方式运用时，姿态呼应似乎能对言语交流起补充作用。",
    "vocabulary": [
      "complement"
    ]
  },
  {
    "file": "screen085.png",
    "sha256": "c223cb022319b1e9ba9b3f709533342d569546b43d78a1b6048f012f3012e626",
    "k": 79,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "Of course, when such imitation is carried out consciously, it often indicates that someone is mocking at another speaker.",
    "zh": "当然，如果这种模仿是有意为之，通常就表示一个人在嘲弄另一位交谈者。",
    "vocabulary": [
      "mock"
    ]
  },
  {
    "file": "screen086.png",
    "sha256": "64ad342c61c50c48735470151639e842699995cb063e839adafba8463cdad59a",
    "k": 80,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "OK. In today’s lecture, we looked at some paralinguistic features, such as tone of voice, gesture and posture.",
    "zh": "好，今天的讲座讨论了一些副语言特征，例如语气、手势和姿态。",
    "vocabulary": [
      "paralinguistic"
    ]
  },
  {
    "file": "screen087.png",
    "sha256": "d831b5638656e85551c4f4b7a69338e3f1baa7d9ec362b5afd869ef715eefd54",
    "k": 81,
    "part": 1,
    "parts": 2,
    "role": null,
    "en": "These features, together with linguistic features of language, like grammar, or vocabulary, ",
    "zh": "这些特征，与语法、词汇等语言特征一起，",
    "vocabulary": [
      "linguistic"
    ]
  },
  {
    "file": "screen088.png",
    "sha256": "644a6d10e9947dc77199acb970fc72154554b6dc639061d9e5529c0532b1f7f0",
    "k": 81,
    "part": 2,
    "parts": 2,
    "role": null,
    "en": "are all part of the way we communicate with each other in face to face encounters.",
    "zh": "都构成了面对面交流方式的一部分。",
    "vocabulary": [
      "face to face"
    ]
  },
  {
    "file": "screen089.png",
    "sha256": "dc53a0816db0b45de4c1f5918441530eb11d0aa70358fb7145e5ba306551c72d",
    "k": 82,
    "part": 1,
    "parts": 2,
    "role": null,
    "en": "In our next lecture, we’ll watch some video material, ",
    "zh": "下一堂课，我们会看一些视频材料，",
    "vocabulary": [
      "video material"
    ]
  },
  {
    "file": "screen090.png",
    "sha256": "f78d0689df2b94484791cb15f9277bbef16d70197ada9da6d9b4b03b3987f839",
    "k": 82,
    "part": 2,
    "parts": 2,
    "role": null,
    "en": "and see how people actually use paralinguistic means in communication to express their intention or desire or mood.",
    "zh": "了解人们在交流中如何实际运用副语言手段，来表达意图、愿望或情绪。",
    "vocabulary": [
      "mood"
    ]
  },
  {
    "file": "screen091.png",
    "sha256": "ef943595b4f73b927fc23a58d7aac97aff95ff18df413f4eb1ef61b49e078362",
    "k": 83,
    "part": 1,
    "parts": 1,
    "role": "transition",
    "en": "Now you have three minutes to check your work.",
    "zh": "现在你有三分钟检查作答。",
    "vocabulary": [
      "check"
    ]
  },
  {
    "file": "screen092.png",
    "sha256": "506bbbe21d3386f521de0a4128c87b4cedfd20dac23f305e08065f1e25c9bd24",
    "k": 84,
    "part": 1,
    "parts": 1,
    "role": "transition",
    "en": "This is the end of section A mini-lecture.",
    "zh": "A节短讲到此结束。",
    "vocabulary": [
      "end"
    ]
  }
]
