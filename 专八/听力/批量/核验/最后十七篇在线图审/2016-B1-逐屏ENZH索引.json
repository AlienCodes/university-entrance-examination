    "sha256": "a68fe68d92a41c69b288fae395a19a95e9143c389e650719fac8c91de79a9052",
    "k": 5,
    "part": 1,
    "parts": 1,
    "role": "instruction",
    "en": "Both the interview and the questions will be spoken once only.",
    "zh": "访谈和问题都只读一遍。",
    "vocabulary": [
      "once"
    ]
  },
  {
    "file": "screen007.png",
    "sha256": "ae95247f9b38def303f0a334595168bcae62c1079565889039a155c16a70cd2c",
    "k": 6,
    "part": 1,
    "parts": 1,
    "role": "instruction",
    "en": "After each question, there will be a ten-second pause.",
    "zh": "每个问题之后会有十秒钟的停顿。",
    "vocabulary": [
      "pause"
    ]
  },
  {
    "file": "screen008.png",
    "sha256": "53f7c4e493d329b27d27707be75d7418ba330f32200331ee7f7c417dfcd3b552",
    "k": 7,
    "part": 1,
    "parts": 1,
    "role": "instruction",
    "en": "During the pause, you should read the four choices of A, B, C, and D and mark the best answer to each question on answer sheet 2.",
    "zh": "请利用停顿时间阅读A、B、C、D四个选项，并在答题卡二上标出每题的最佳答案。",
    "vocabulary": [
      "choice"
    ]
  },
  {
    "file": "screen009.png",
    "sha256": "81264fc18e74691eab88b6efe61dd24eef82b3424d9481b9d00df0e3f838cdbf",
    "k": 8,
    "part": 1,
    "parts": 1,
    "role": "instruction",
    "en": "You have 30 seconds to preview the questions.",
    "zh": "你有三十秒钟预览题目。",
    "vocabulary": [
      "preview"
    ]
  },
  {
    "file": "screen010.png",
    "sha256": "fa322e3ca7187da5ee67f1e5b663acf74ea81ddceab39bd1166f454ab94bfddd",
    "k": 9,
    "part": 1,
    "parts": 1,
    "role": "transition",
    "en": "Now listen to part one of the interviews.",
    "zh": "现在请听访谈的第一部分。",
    "vocabulary": [
      "listen"
    ]
  },
  {
    "file": "screen011.png",
    "sha256": "5c305d9dc9176ba229ce43f2931b0f62429905936f14630475a20d8227f39ffd",
    "k": 10,
    "part": 1,
    "parts": 1,
    "role": "transition",
    "en": "Questions one to five are based on part one of the interview.",
    "zh": "第1至5题根据访谈的第一部分提问。",
    "vocabulary": [
      "be based on"
    ]
  },
  {
    "file": "screen012.png",
    "sha256": "81383459396bd452497e8968029da5b1cf1c9f13628cbee9c9c08529e71763e8",
    "k": 11,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "Good evening, everybody.",
    "zh": "各位晚上好。",
    "vocabulary": [
      "good evening"
    ]
  },
  {
    "file": "screen013.png",
    "sha256": "59e6325e6683bc424951492cb755659a4f750e9123ed04864ea18b61a43a4c19",
    "k": 12,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "Today we are pleased to have invited Maggie Shorts from Harvard University to tell us her feeling of studying together with her mom.",
    "zh": "今天我们很高兴邀请到哈佛大学的玛吉·肖茨，请她谈谈与妈妈一起上大学的感受。",
    "vocabulary": [
      "invite"
    ]
  },
  {
    "file": "screen014.png",
    "sha256": "8fc5267cd8fa06d11ee25b2c1ed99d040abd9a63750c04ce96bcd1e018a9d715",
    "k": 13,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "Well, Maggie.",
    "zh": "那么，玛吉。",
    "vocabulary": [
      "well"
    ]
  },
  {
    "file": "screen015.png",
    "sha256": "854330847afd341e17d66ee3e763e53ce6805ed77f6dde36634a4153d8e0448c",
    "k": 14,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "Thanks.",
    "zh": "谢谢。",
    "vocabulary": [
      "thanks"
    ]
  },
  {
    "file": "screen016.png",
    "sha256": "f791441c11a29021860e73302bbebf58ac474c361991da89ba08add30ba88f4e",
    "k": 15,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "I’m very happy to meet you all.",
    "zh": "很高兴见到大家。",
    "vocabulary": [
      "meet"
    ]
  },
  {
    "file": "screen017.png",
    "sha256": "62525b83d8b2c76a41019f85a56846c9d97322ecaf464f36c795d5388d3e1b48",
    "k": 16,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "Maggie, are you and your mom studying the same major at the university?",
    "zh": "玛吉，你和妈妈在大学里学的是同一个专业吗？",
    "vocabulary": [
      "major"
    ]
  },
  {
    "file": "screen018.png",
    "sha256": "100195cb9d7e6ce405068bd9bfb0f7fe97ba7a4aebbfdafbcc28d559cad8dcf4",
    "k": 17,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "Not really.",
    "zh": "并不是。",
    "vocabulary": [
      "not really"
    ]
  },
  {
    "file": "screen019.png",
    "sha256": "8045d27e085a2902581a4da9bb013893e439e09ee1a593c0e5eafe37e77a0936",
    "k": 18,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "She is studying in law school and I’m studying journalism.",
    "zh": "她在法学院读书，而我学的是新闻学。",
    "vocabulary": [
      "journalism"
    ]
  },
  {
    "file": "screen020.png",
    "sha256": "64edaf595348d40bfa395b2a4363f916c78568f8ddedca386c66cd4ec5b69b8d",
    "k": 19,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "So, you see she is a graduate student while I am an undergraduate.",
    "zh": "所以，她是研究生，而我是本科生。",
    "vocabulary": [
      "undergraduate"
    ]
  },
  {
    "file": "screen021.png",
    "sha256": "4114481c3d394201628be00a217ac55b77e1ce673c86dd8cd12f7af4be233604",
    "k": 20,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "Since we started at the same time and hers is a four-year night program, our school schedules are synched.",
    "zh": "我们是同时开始上学的，而她读的是四年制夜校课程，所以我们的学习日程同步。",
    "vocabulary": [
      "synch"
    ]
  },
  {
    "file": "screen022.png",
    "sha256": "1915aeb6aea24b9981fe22d2b8e9b1cb3781764dd66bcc69486f58873f9a9c6b",
    "k": 21,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "Which means?",
    "zh": "也就是说呢？",
    "vocabulary": [
      "mean"
    ]
  },
  {
    "file": "screen023.png",
    "sha256": "01d235c3f5e6859bc3447a387c3d085810f4c441ec3424139a47d51d58e6064b",
    "k": 22,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "We follow the same schedule of study.",
    "zh": "我们的学习日程安排是一样的。",
    "vocabulary": [
      "schedule"
    ]
  },
  {
    "file": "screen024.png",
    "sha256": "32b8465f916f27b11f13a3e0b690adb7e2646b2f407c59185af450d5d96216fc",
    "k": 23,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "We take our exams during the same busy weeks and experience similar relief at the end of December and May.",
    "zh": "我们都在同样忙碌的几个星期里考试，也都在十二月和五月结束时如释重负。",
    "vocabulary": [
      "relief"
    ]
  },
  {
    "file": "screen025.png",
    "sha256": "86ae541de7583f745e97efea3a02b40d690ff3a1e0f5f3b8c6156417c7f6bd3c",
    "k": 24,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "Last spring, we compared notes on our cover letters and interviews for our job applications.",
    "zh": "去年春天，我们还交流了求职信和求职面试方面的心得。",
    "vocabulary": [
      "cover letter"
    ]
  },
  {
    "file": "screen026.png",
    "sha256": "b10c0419a0a33c12c851832150641e97f1a52b24c69225caa39892ec7dde1211",
    "k": 25,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "Last June, as we were both preparing for our summer internships, my mother and I traded fashion advice.",
    "zh": "去年六月，我们都在准备暑期实习，妈妈和我还交换过穿搭建议。",
    "vocabulary": [
      "internship"
    ]
  },
  {
    "file": "screen027.png",
    "sha256": "5749350ccb6888d124e6858d5dc557f942608aab1335491577fc51756d5dd669",
    "k": 26,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "Presently, we will probably graduate within days of each other.",
    "zh": "目前看来，我们毕业的日期可能只相差几天。",
    "vocabulary": [
      "graduate"
    ]
  },
  {
    "file": "screen028.png",
    "sha256": "ea8ce3d818791ae5afef37d8f91f0f7faea42ee364b2114f7cead20fc96f61bb",
    "k": 27,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "Interesting.",
    "zh": "真有意思。",
    "vocabulary": [
      "interesting"
    ]
  },
  {
    "file": "screen029.png",
    "sha256": "3ba3c613341db54783d00082a053548bc4e3dedea6464b9995f8fb7157c9b2e0",
    "k": 28,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "Then you must have a lot in common at study.",
    "zh": "那么，你们在学习上一定有不少共同点。",
    "vocabulary": [
      "have a lot in common"
    ]
  },
  {
    "file": "screen030.png",
    "sha256": "967873d0cead43edd7d2c1ad5896d0966c84d8533cc7468eabec68789fc22024",
    "k": 29,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "You bet.",
    "zh": "那当然。",
    "vocabulary": [
      "you bet"
    ]
  },
  {
    "file": "screen031.png",
    "sha256": "44706fb4b434461a623acff01cd89d88a23fc7d5c75bedbeec9b0b8fcba33019",
    "k": 30,
    "part": 1,
    "parts": 2,
    "role": null,
    "en": "As students, we’ve shared study habits (take notes by hand), general truths (You can’t avoid having a few bad professors), ",
    "zh": "作为学生，我们有共同的学习习惯，比如手写笔记；有共同的体会，比如难免会碰到几个不太好的教授；",
    "vocabulary": [
      "study habit"
    ]
  },
  {
    "file": "screen032.png",
    "sha256": "2a89acedb78de90a3fa21af2ebfce50e3d4182a3b9d5a0b28f8479143456a85b",
    "k": 30,
    "part": 2,
    "parts": 2,
    "role": null,
    "en": "and encouraging platitudes (like, it’s okay! No one will care how you did on your “Science of Cooking” or “Constitutional Law” midterm!).",
    "zh": "也会说些鼓励人的套话，比如“没关系，没人会在意你《烹饪科学》或《宪法学》期中考得怎么样！”",
    "vocabulary": [
      "platitude"
    ]
  },
  {
    "file": "screen033.png",
    "sha256": "0f2d8cc0562711b2d04a26c6863fc58cb0a815c802a0e04fa08d177acbaafaae",
    "k": 31,
    "part": 1,
    "parts": 2,
    "role": null,
    "en": "Where she’s listened to my complaints about freshman-year roommates and dining-hall food, ",
    "zh": "她听我抱怨大一时的室友和食堂饭菜，",
    "vocabulary": [
      "complaint"
    ]
  },
  {
    "file": "screen034.png",
    "sha256": "f1a2af722c422718261c2e4934680d4e9ef3c2488b3faf3066e450a4417d3c5b",
    "k": 31,
    "part": 2,
    "parts": 2,
    "role": null,
    "en": "I’ve helped her buy textbooks online and wished her luck in moot-court practice.",
    "zh": "我则帮她在网上买教材，还祝她模拟法庭练习顺利。",
    "vocabulary": [
      "moot-court"
    ]
  },
  {
    "file": "screen035.png",
    "sha256": "f2fcb073326501aeafe32314e3f27b883b41c4532d90ffb78b96729d73ca8b9a",
    "k": 32,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "Occasionally, we’ve even studied together.",
    "zh": "有时我们甚至会一起学习。",
    "vocabulary": [
      "occasionally"
    ]
  },
  {
    "file": "screen036.png",
    "sha256": "719e9fe9d4ba9664462cc210e2cd7fae3b9d6708ebbb3b93adfcae96c2c1c91f",
    "k": 33,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "When Mom came to visit during Freshman Parents Weekend, I took her into the library on the pretext that she was on a library tour.",
    "zh": "妈妈在大一新生家长周末来探望时，我以她在参观图书馆为由，带她进了图书馆。",
    "vocabulary": [
      "on the pretext that"
    ]
  },
  {
    "file": "screen037.png",
    "sha256": "a44ecd78c58f703b52824b44285a8d8899cf8bb3aa5773ddb39f7d0d88d4f64a",
    "k": 34,
    "part": 1,
    "parts": 2,
    "role": null,
    "en": "We sat side by side in the big open room on the first floor—",
    "zh": "我们并排坐在一楼的大阅览室里：",
    "vocabulary": [
      "side by side"
    ]
  },
  {
    "file": "screen038.png",
    "sha256": "1751aa8c8a74bb6da8994cb18365dd959316f923dec8d19c290075d4e6cb16b2",
    "k": 34,
    "part": 2,
    "parts": 2,
    "role": null,
    "en": "she diligently taking notes on a huge red volume that she had lugged from New York City on the train, I casually reading about Greek myths.",
    "zh": "她认真记着笔记，读的是她从纽约坐火车费力带来的一本厚厚的红皮书；我则随意翻看希腊神话。",
    "vocabulary": [
      "diligently"
    ]
  },
  {
    "file": "screen039.png",
    "sha256": "25e3040636aa324de8a296744b6b68078b6f45dd26010136721adf97a3daf64a",
    "k": 35,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "What do you think is the biggest advantage of having a parent studying together with you?",
    "zh": "你觉得和父母一起上大学最大的好处是什么？",
    "vocabulary": [
      "advantage"
    ]
  },
  {
    "file": "screen040.png",
    "sha256": "d58c642edc8ee5dabe5edc93ff6885531e9c1641410ec7e6112ffa51266496c4",
    "k": 36,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "I know that my mother has felt the frustration of a paper that won’t write and the excitement of mastering a difficult topic.",
    "zh": "我知道，妈妈也经历过论文写不出来的挫败感，以及攻克一个难题后的兴奋。",
    "vocabulary": [
      "frustration"
    ]
  },
  {
    "file": "screen041.png",
    "sha256": "86cd702b95a44857fe5254b0156651865b147421cc6f2f9923508b8ddc57271c",
    "k": 37,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "I don’t need to explain my elaborate theory that I am a “bad test-taker”—she said the same thing about herself.",
    "zh": "我不必费心解释自己“不会考试”的那套复杂理论，因为她也这样说过自己。",
    "vocabulary": [
      "elaborate"
    ]
  },
  {
    "file": "screen042.png",
    "sha256": "30d541a5bc43ece55550092a22e9488a282aece28766ce6bc2638b2b7cca6a5b",
    "k": 38,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "And talking with her is a good way to get perspective on those occasional hurdles that crop up in college.",
    "zh": "和她聊聊天，能让我更理性地看待大学里偶尔出现的那些障碍。",
    "vocabulary": [
      "hurdle"
    ]
  },
  {
    "file": "screen043.png",
    "sha256": "9cfb2d86904bdade0d75efeb2483d3929cea4bb7c670bdbda2e189c74083fd80",
    "k": 39,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "Although we are both taking a substantial course load, Mom is also working a full-time job in the financial industry.",
    "zh": "虽然我们两个人的课业都很繁重，但妈妈同时还在金融行业做着一份全职工作。",
    "vocabulary": [
      "substantial"
    ]
  },
  {
    "file": "screen044.png",
    "sha256": "17893b44708d51ce11a5a6e19170b2d951e0b210d679edb46aa2543ce6f9e5d7",
    "k": 40,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "That urges me to study harder, so I should say encouragement.",
    "zh": "这激励我更加努力地学习，所以我会说，最大的好处是受到鼓舞。",
    "vocabulary": [
      "encouragement"
    ]
  },
  {
    "file": "screen045.png",
    "sha256": "f56880d6dcf7c200f2ea4097cee9c921fd163fb70eff7cbd0b2080b7baef1717",
    "k": 41,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "Any disadvantages then?",
    "zh": "那么，有什么不利之处吗？",
    "vocabulary": [
      "disadvantage"
    ]
  },
  {
    "file": "screen046.png",
    "sha256": "a69ca1a85d909b0c911ea65ac51dbb8c90ea179196eb2f9f87520c4da5052042",
    "k": 42,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "Well, sometimes I wonder whether we are getting a little too involved in each other’s scholastic lives.",
    "zh": "有时候，我会想，我们是不是过多地介入了彼此的学业生活。",
    "vocabulary": [
      "scholastic"
    ]
  },
  {
    "file": "screen047.png",
    "sha256": "cbcb49774f06853d762ba73ec3e0c5772af3f04b8ca7815550e39ea227c5621f",
    "k": 43,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "This usually occurs to me about twice a year, when my mother calls to inform me of her grades.",
    "zh": "通常每年大约有两次，妈妈打电话告诉我她的成绩时，我就会这样想。",
    "vocabulary": [
      "inform"
    ]
  },
  {
    "file": "screen048.png",
