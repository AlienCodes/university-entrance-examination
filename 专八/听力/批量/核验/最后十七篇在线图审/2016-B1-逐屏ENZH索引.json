    ]
  },
  {
    "file": "screen005.png",
    "sha256": "378643cd59d74a71cac3529c2fff07cf1c3ba6443771837f84330cd7359fe044",
    "k": 4,
    "part": 1,
    "parts": 1,
    "role": "instruction",
    "en": "At the end of each part, five questions will be asked about what was said.",
    "zh": "每部分结束后，将就刚才所说的内容提出五个问题。",
    "vocabulary": [
      "question"
    ]
  },
  {
