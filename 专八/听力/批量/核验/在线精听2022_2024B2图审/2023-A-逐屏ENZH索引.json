    ]
  },
  {
    "file": "screen013.png",
    "sha256": "c94438f40a1f6bd83f1adf6b19a80ab4464b8723c6835197ee26b223a3a92567",
    "k": 12,
    "part": 1,
    "parts": 1,
    "role": "transition",
