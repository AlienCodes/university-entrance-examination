    "k": 36,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "All right, Ben. Thank you so much for talking to us.",
    "zh": "好的，本。非常感谢您接受我们的采访。",
    "vocabulary": [
      "Thank you"
    ]
  },
