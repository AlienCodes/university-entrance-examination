    "sha256": "656e9765b8e532e8c8f59cd7c3118db5360dc2097ac8531a03e379ebcca3ddc0",
    "k": 34,
    "part": 1,
    "parts": 1,
    "role": null,
    "en": "Slower change will be much more manageable than the fast change.",
    "zh": "与快速变化相比，较慢的变化会更容易应对。",
    "vocabulary": [
      "manageable"
    ]
  },
  {
    "file": "screen043.png",
