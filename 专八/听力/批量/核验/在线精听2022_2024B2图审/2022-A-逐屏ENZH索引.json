    ]
  },
  {
    "file": "screen013.png",
    "sha256": "2a341aa3f6662a774e5603e6469a89faa4f24dd065444e82556dad739e727a6f",
    "k": 12,
    "part": 1,
    "parts": 1,
    "role": "transition",
