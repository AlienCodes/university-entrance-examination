    "zh": "访谈和问题都只读一遍。",
    "vocabulary": [
      "once"
    ]
  },
  {
    "file": "screen007.png",
    "sha256": "7213419de9da5635e175131160da96a5a76ffdea5a4b6b5ddcaf8ee6ad4d140d",
    "k": 6,
    "part": 1,
    "parts": 1,
    "role": "instruction",
